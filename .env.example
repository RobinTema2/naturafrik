# ══════════════════════════════════════════════════
# NATURAFRIK — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# NE JAMAIS committer le fichier .env sur GitHub
# ══════════════════════════════════════════════════

# ── Base de données ──────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=naturafrik
DB_USER=root
DB_PASS=

# ── URL du site ──────────────────────────────────
# Local XAMPP  → SITE_BASE=/naturafrik
# Railway/root → SITE_BASE=
# Sous-domaine → SITE_BASE=
SITE_BASE=/naturafrik
SITE_URL=http://localhost/naturafrik

# ── Sécurité ─────────────────────────────────────
SECRET_KEY=changez_cette_cle_en_production_minimum_32_chars
